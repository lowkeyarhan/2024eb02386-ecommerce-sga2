<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ecommerce Office | Order & Inventory</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-mark">E.</span>
      <span>ecommerce office<small>orders · inventory · operations</small></span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      <a href="/">Overview</a>
      <a href="/products">Products</a>
      <a href="/categories">Categories</a>
      <a href="/customers">Customers</a>
      <a href="/sellers">Sellers</a>
      <a href="/cart">Cart</a>
      <a href="/orders">Orders</a>
      <a href="/returns">Returns</a>
      <a href="/inventory">Inventory</a>
      <a href="/reports">Reports</a>
    </nav>
  </div>
</header>
<main class="container">
  <c:if test="${not empty success}"><div class="alert" role="status"><c:out value="${success}"/></div></c:if>
  <c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if>
