<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Report 03</p><h1>Top-selling products</h1><p class="subheading">Products ranked by the total number of units appearing in non-cancelled orders.</p></div><a href="/reports" class="button secondary">All reports</a></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Rank</th><th>Product</th><th>SKU</th><th>Category</th><th>Seller</th><th>Current stock</th></tr></thead><tbody><c:forEach items="${products}" var="product" varStatus="loop"><tr><td><span class="badge">#<c:out value="${loop.count}"/></span></td><td class="table-title"><c:out value="${product.productName}"/></td><td><c:out value="${product.sku}"/></td><td><c:out value="${product.category.categoryName}"/></td><td><c:out value="${product.seller.sellerName}"/></td><td><c:out value="${product.stockQuantity}"/></td></tr></c:forEach><c:if test="${empty products}"><tr><td colspan="6" class="empty">No sales data available yet.</td></tr></c:if></tbody></table></div></section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
