<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Report 01</p><h1>Low-stock inventory</h1><p class="subheading">Every product whose current stock is at or below its reorder level.</p></div><a href="/reports" class="button secondary">All reports</a></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>SKU</th><th>Product</th><th>Seller</th><th>Stock on hand</th><th>Reorder level</th><th>Signal</th></tr></thead><tbody><c:forEach items="${products}" var="product"><tr><td><c:out value="${product.sku}"/></td><td class="table-title"><c:out value="${product.productName}"/></td><td><c:out value="${product.seller.sellerName}"/></td><td><strong><c:out value="${product.stockQuantity}"/></strong></td><td><c:out value="${product.reorderLevel}"/></td><td><span class="badge warning">Reorder</span></td></tr></c:forEach><c:if test="${empty products}"><tr><td colspan="6" class="empty">All product stock levels are healthy.</td></tr></c:if></tbody></table></div></section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
