<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Stock operations</p><h1>Inventory</h1><p class="subheading">Stock movements are auditable. Restocks and returns are recorded as positive ledger entries; checkout writes sale entries.</p></div><a class="button secondary" href="/reports/low-stock">Low-stock report</a></section>
<div class="two-column">
<section class="panel"><p class="eyebrow">Replenishment watch</p><h2>Products at reorder level</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>On hand</th><th>Reorder at</th></tr></thead><tbody><c:forEach items="${lowStock}" var="product"><tr><td><span class="table-title"><c:out value="${product.productName}"/></span><span class="table-meta"><c:out value="${product.sku}"/></span></td><td><span class="badge warning"><c:out value="${product.stockQuantity}"/></span></td><td><c:out value="${product.reorderLevel}"/></td></tr></c:forEach><c:if test="${empty lowStock}"><tr><td colspan="3" class="empty">No low-stock products.</td></tr></c:if></tbody></table></div></section>
<section class="panel"><p class="eyebrow">Inventory operator</p><h2>Record a restock</h2><form method="post" action="/inventory/restock" data-validate>
<div class="field"><label for="productId">Product</label><select id="productId" name="productId" required><option value="">Choose product</option><c:forEach items="${products}" var="product"><option value="${product.id}"><c:out value="${product.productName}"/> · <c:out value="${product.sku}"/></option></c:forEach></select></div>
<div class="field"><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" min="1" step="1" required></div>
<div class="field"><label for="note">Note</label><input id="note" name="note" maxlength="300" placeholder="Supplier delivery / stock correction"></div><button type="submit">Restock inventory</button></form></section>
</div>
<section class="panel"><p class="eyebrow">Audit trail</p><h2>Latest inventory movements</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Product</th><th>Change</th><th>Reason</th><th>Order</th><th>Note</th></tr></thead><tbody><c:forEach items="${movements}" var="movement"><tr><td><c:out value="${movement.occurredAt}"/></td><td><span class="table-title"><c:out value="${movement.product.productName}"/></span></td><td><strong><c:if test="${movement.quantityDelta > 0}">+</c:if><c:out value="${movement.quantityDelta}"/></strong></td><td><span class="badge"><c:out value="${movement.reason}"/></span></td><td><c:out value="${movement.order.id}" default="-"/></td><td><c:out value="${movement.note}"/></td></tr></c:forEach><c:if test="${empty movements}"><tr><td colspan="6" class="empty">No inventory movements yet.</td></tr></c:if></tbody></table></div></section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
