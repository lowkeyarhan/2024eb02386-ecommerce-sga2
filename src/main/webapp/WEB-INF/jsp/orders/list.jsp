<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Order operations</p><h1>Orders</h1><p class="subheading">Search order records by customer, ID or status.</p></div><a class="button secondary" href="/orders/history">Customer history</a></section>
<section class="panel"><form method="get" action="/orders" class="toolbar"><input name="q" value="<c:out value='${q}'/>" type="search" placeholder="Customer name or order #"><select name="status"><option value="">All statuses</option><c:forEach items="${['CONFIRMED','PROCESSING','SHIPPED','DELIVERED','CANCELLED','RETURNED']}" var="s"><option value="${s}" <c:if test="${s == status}">selected</c:if>><c:out value="${s}"/></option></c:forEach></select><button type="submit">Filter</button><a class="button secondary" href="/orders">Reset</a></form></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>
<c:forEach items="${orders}" var="order"><tr><td class="table-title">#<c:out value="${order.id}"/></td><td><c:out value="${order.customer.firstName}"/> <c:out value="${order.customer.lastName}"/></td><td><c:out value="${order.orderDate}"/></td><td><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></td><td><span class="badge <c:if test='${order.status == "DELIVERED"}'>success</c:if>"><c:out value="${order.status}"/></span></td><td><a href="/orders/${order.id}">View →</a></td></tr></c:forEach>
<c:if test="${empty orders}"><tr><td colspan="6" class="empty">No orders found.</td></tr></c:if>
</tbody></table></div><div class="pagination"><span><c:out value="${orderPage.totalElements}"/> orders · page <c:out value="${orderPage.number + 1}"/> of <c:out value="${orderPage.totalPages}"/></span><div class="actions"><c:if test="${orderPage.hasPrevious()}"><a class="button secondary small" href="/orders?q=${q}&status=${status}&page=${orderPage.number - 1}">Previous</a></c:if><c:if test="${orderPage.hasNext()}"><a class="button secondary small" href="/orders?q=${q}&status=${status}&page=${orderPage.number + 1}">Next</a></c:if></div></div></section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
