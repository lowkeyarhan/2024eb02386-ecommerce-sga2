<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Order record</p><h1>Order #<c:out value="${order.id}"/></h1><p class="subheading">Placed <c:out value="${order.orderDate}"/> · <span class="badge"><c:out value="${order.status}"/></span></p></div><div class="action-row"><a class="button secondary" href="/orders">Back to orders</a><c:if test="${order.status == 'DELIVERED'}"><a class="button" href="/returns/new?orderId=${order.id}">Request return</a></c:if></div></section>
<div class="two-column">
<section class="panel"><h2>Purchased items</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody><c:forEach items="${items}" var="item"><tr><td><span class="table-title"><c:out value="${item.product.productName}"/></span><span class="table-meta"><c:out value="${item.product.sku}"/></span></td><td><c:out value="${item.quantity}"/></td><td><fmt:formatNumber value="${item.unitPrice}" type="currency" currencyCode="INR"/></td><td><fmt:formatNumber value="${item.lineTotal}" type="currency" currencyCode="INR"/></td></tr></c:forEach></tbody></table></div>
<h2 class="mt-16">Payments</h2><div class="table-wrap"><table><thead><tr><th>Type</th><th>Method</th><th>Amount</th><th>Status</th></tr></thead><tbody><c:forEach items="${payments}" var="payment"><tr><td><c:out value="${payment.paymentKind}"/></td><td><c:out value="${payment.method}"/></td><td><fmt:formatNumber value="${payment.amount}" type="currency" currencyCode="INR"/></td><td><span class="badge success"><c:out value="${payment.status}"/></span></td></tr></c:forEach></tbody></table></div>
</section>
<section class="panel"><p class="eyebrow">Summary</p><h2>Order totals</h2><div class="detail-list"><span>Subtotal</span><strong><fmt:formatNumber value="${order.subtotal}" type="currency" currencyCode="INR"/></strong><span>Shipping</span><strong><fmt:formatNumber value="${order.shippingFee}" type="currency" currencyCode="INR"/></strong><span>Tax</span><strong><fmt:formatNumber value="${order.taxAmount}" type="currency" currencyCode="INR"/></strong><span>Total</span><strong><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></strong></div>
<hr style="border:0;border-top:1px solid var(--line);margin:18px 0"><h2>Shipping</h2><c:if test="${not empty shipment}"><div class="detail-list"><span>Carrier</span><strong><c:out value="${shipment.carrier}"/></strong><span>Tracking</span><strong><c:out value="${shipment.trackingNumber}"/></strong><span>Status</span><strong><c:out value="${shipment.status}"/></strong></div></c:if><c:if test="${empty shipment}"><p class="muted">No shipment record yet.</p></c:if>
<hr style="border:0;border-top:1px solid var(--line);margin:18px 0"><h2>Ship to</h2><p><c:out value="${order.shippingAddress.addressLine1}"/><br><c:out value="${order.shippingAddress.city}"/>, <c:out value="${order.shippingAddress.stateRegion}"/> <c:out value="${order.shippingAddress.postalCode}"/><br><c:out value="${order.shippingAddress.country}"/></p>
</section></div>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
