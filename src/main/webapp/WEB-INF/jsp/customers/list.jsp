<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Customer records</p><h1>Customers</h1><p class="subheading">Search customer identity and maintain contact records.</p></div><a class="button" href="/customers/new">+ Add customer</a></section>
<section class="panel"><form method="get" action="/customers" class="toolbar"><input type="search" name="q" value="<c:out value='${q}'/>" placeholder="Search customer or email"><select name="sort"><option value="firstName" <c:if test="${sort == 'firstName'}">selected</c:if>>First name</option><option value="lastName" <c:if test="${sort == 'lastName'}">selected</c:if>>Last name</option><option value="email" <c:if test="${sort == 'email'}">selected</c:if>>Email</option><option value="createdAt" <c:if test="${sort == 'createdAt'}">selected</c:if>>Created</option></select><select name="direction"><option value="asc">Ascending</option><option value="desc" <c:if test="${direction == 'desc'}">selected</c:if>>Descending</option></select><button type="submit">Search</button><a class="button secondary" href="/customers">Reset</a></form></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Email</th><th>Phone</th><th>Created</th><th>Actions</th></tr></thead><tbody>
<c:forEach items="${customers}" var="customer"><tr><td><span class="table-title"><c:out value="${customer.firstName}"/> <c:out value="${customer.lastName}"/></span><span class="table-meta">Customer #<c:out value="${customer.id}"/></span></td><td><c:out value="${customer.email}"/></td><td><c:out value="${customer.phone}" default="-"/></td><td><c:out value="${customer.createdAt}"/></td><td><div class="action-row"><a href="/customers/${customer.id}/edit">Edit</a><form method="post" action="/customers/${customer.id}/delete"><button class="small danger" type="submit" data-confirm="Delete this customer? Linked orders may prevent deletion.">Delete</button></form></div></td></tr></c:forEach>
<c:if test="${empty customers}"><tr><td colspan="5" class="empty">No customers match the search.</td></tr></c:if>
</tbody></table></div>
<div class="pagination"><span><c:out value="${customerPage.totalElements}"/> customers · page <c:out value="${customerPage.number + 1}"/> of <c:out value="${customerPage.totalPages}"/></span><div class="actions"><c:if test="${customerPage.hasPrevious()}"><a class="button secondary small" href="/customers?q=${q}&sort=${sort}&direction=${direction}&page=${customerPage.number - 1}">Previous</a></c:if><c:if test="${customerPage.hasNext()}"><a class="button secondary small" href="/customers?q=${q}&sort=${sort}&direction=${direction}&page=${customerPage.number + 1}">Next</a></c:if></div></div>
</section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
