<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">After-sales operations</p><h1>Returns & refunds</h1><p class="subheading">Review return requests and process receipt, inventory restoration and linked refunds.</p></div><a class="button secondary" href="/orders">Find an order</a></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Return</th><th>Order</th><th>Customer</th><th>Reason</th><th>Requested</th><th>Status</th><th>Action</th></tr></thead><tbody>
<c:forEach items="${returns}" var="request"><tr><td class="table-title">#<c:out value="${request.id}"/></td><td><a href="/orders/${request.order.id}">#<c:out value="${request.order.id}"/></a></td><td><c:out value="${request.order.customer.firstName}"/> <c:out value="${request.order.customer.lastName}"/></td><td><c:out value="${request.reason}"/></td><td><c:out value="${request.requestedAt}"/></td><td><span class="badge <c:if test='${request.status == "RECEIVED"}'>success</c:if><c:if test='${request.status == "REQUESTED"}'>warning</c:if>"><c:out value="${request.status}"/></span></td><td>
<c:choose><c:when test="${request.status == 'REQUESTED'}"><div class="action-row"><form method="post" action="/returns/${request.id}/action"><input type="hidden" name="action" value="APPROVE"><button class="small" type="submit">Approve</button></form><form method="post" action="/returns/${request.id}/action"><input type="hidden" name="action" value="REJECT"><button class="small danger" type="submit">Reject</button></form></div></c:when><c:when test="${request.status == 'APPROVED'}"><form method="post" action="/returns/${request.id}/action"><input type="hidden" name="action" value="RECEIVE"><button class="small" type="submit" data-confirm="Receive this return and issue the refund?">Receive & refund</button></form></c:when><c:otherwise><span class="muted">Completed</span></c:otherwise></c:choose>
</td></tr></c:forEach>
<c:if test="${empty returns}"><tr><td colspan="7" class="empty">No return requests have been submitted.</td></tr></c:if>
</tbody></table></div></section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
