<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Customer account view</p><h1>Order history</h1><p class="subheading">A paginated view of a customer's previous orders.</p></div><a class="button secondary" href="/orders">All orders</a></section>
<section class="panel"><form method="get" action="/orders/history" class="toolbar"><label for="customerId" style="margin:0">Customer</label><select id="customerId" name="customerId" style="max-width:320px"><c:forEach items="${customers}" var="customer"><option value="${customer.id}" <c:if test="${customer.id == selectedCustomerId}">selected</c:if>><c:out value="${customer.firstName}"/> <c:out value="${customer.lastName}"/> (#<c:out value="${customer.id}"/>)</option></c:forEach></select><button type="submit">Show history</button></form></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Order</th><th>Placed</th><th>Shipping address</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>
<c:forEach items="${orders}" var="order"><tr><td class="table-title">#<c:out value="${order.id}"/></td><td><c:out value="${order.orderDate}"/></td><td><c:out value="${order.shippingAddress.city}"/>, <c:out value="${order.shippingAddress.stateRegion}"/></td><td><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></td><td><span class="badge"><c:out value="${order.status}"/></span></td><td><a href="/orders/${order.id}">Details</a></td></tr></c:forEach>
<c:if test="${empty orders}"><tr><td colspan="6" class="empty">No orders for this customer yet.</td></tr></c:if>
</tbody></table></div><div class="pagination"><span>Page <c:out value="${orderPage.number + 1}"/> of <c:out value="${orderPage.totalPages}"/></span><div class="actions"><c:if test="${orderPage.hasPrevious()}"><a class="button secondary small" href="/orders/history?customerId=${selectedCustomerId}&page=${orderPage.number - 1}">Previous</a></c:if><c:if test="${orderPage.hasNext()}"><a class="button secondary small" href="/orders/history?customerId=${selectedCustomerId}&page=${orderPage.number + 1}">Next</a></c:if></div></div></section>
<%@ include file="/WEB-INF/jsp/fragments/footer.jspf" %>
