digraph EcommerceER {
  graph [rankdir=LR, splines=ortho, nodesep=0.32, ranksep=0.55, bgcolor="#ffffff", pad=0.25, fontname="Helvetica", label="E-Commerce Order & Inventory | 15-table SGA1 model", labelloc=t, fontsize=20];
  node [shape=record, style="rounded,filled", fillcolor="#f5f8f6", color="#b8cbc1", fontname="Helvetica", fontsize=9, margin="0.10,0.07"];
  edge [color="#69877a", arrowsize=0.7, fontname="Helvetica", fontsize=8];
  customers [label="{customers|PK customer_id\lfirst_name, last_name\lemail UNIQUE\lphone, created_at\l}"];
  customer_addresses [label="{customer_addresses|PK address_id\lFK customer_id\laddress, city, state\lpostal_code, country\l}"];
  sellers [label="{sellers|PK seller_id\lseller_name UNIQUE\lcontact_email UNIQUE\lstatus, created_at\l}"];
  categories [label="{categories|PK category_id\lFK parent_category_id\lcategory_name UNIQUE\l}"];
  products [label="{products|PK product_id\lFK seller_id, category_id\lSKU UNIQUE, name\lprice, stock, reorder\l}"];
  carts [label="{carts|PK cart_id\lFK customer_id\lstatus, created_at\lopen_customer_id (generated)\l}"];
  cart_items [label="{cart_items|PK cart_item_id\lFK cart_id, product_id\lquantity, added_at\lUNIQUE(cart_id, product_id)\l}"];
  orders [label="{orders|PK order_id\lFK customer_id, shipping_address_id\lstatus, order_date\lsubtotal, shipping, tax, total\l}"];
  order_items [label="{order_items|PK order_item_id\lFK order_id, product_id\lquantity, unit_price, line_total\lUNIQUE(order_id, product_id)\l}"];
  payments [label="{payments|PK payment_id\lFK order_id\lFK related_payment_id\lkind, method, amount, status\l}"];
  shipments [label="{shipments|PK shipment_id\lFK order_id UNIQUE\lcarrier, tracking, status\lshipped_at, delivered_at\l}"];
  product_returns [label="{product_returns|PK return_id\lFK order_id\lrequested_at, reason, status\lprocessed_at\l}"];
  return_items [label="{return_items|PK return_item_id\lFK return_id, order_item_id\lquantity\lUNIQUE(return_id, order_item_id)\l}"];
  product_reviews [label="{product_reviews|PK review_id\lFK customer_id, product_id\lrating, review_text\lUNIQUE(customer_id, product_id)\l}"];
  inventory_movements [label="{inventory_movements|PK movement_id\lFK product_id, order_id\lquantity_delta, reason\lnote, occurred_at\l}"];

  customers -> customer_addresses [label="1 : N"];
  customers -> carts [label="1 : N"];
  customers -> orders [label="1 : N"];
  customers -> product_reviews [label="1 : N"];
  sellers -> products [label="1 : N"];
  categories -> products [label="1 : N"];
  categories -> categories [label="parent / child"];
  carts -> cart_items [label="1 : N"];
  products -> cart_items [label="1 : N"];
  orders -> order_items [label="1 : N"];
  products -> order_items [label="1 : N"];
  orders -> payments [label="1 : N"];
  payments -> payments [label="refund-of"];
  orders -> shipments [label="1 : 0..1"];
  orders -> product_returns [label="1 : N"];
  product_returns -> return_items [label="1 : N"];
  order_items -> return_items [label="1 : N"];
  products -> product_reviews [label="1 : N"];
  products -> inventory_movements [label="1 : N"];
  orders -> inventory_movements [label="1 : N optional"];
}
